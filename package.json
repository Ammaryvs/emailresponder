{
  "name": "gmail-reply-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension that drafts Gmail replies using Claude.",
  "type": "module",
  "scripts": {
    "build:background": "vite build --config vite.config.background.ts",
    "build:content": "vite build --config vite.config.content.ts",
    "build:options": "vite build --config vite.config.options.ts",
    "copy:static": "node scripts/copy-static.mjs",
    "build": "npm run build:background && npm run build:content && npm run build:options && npm run copy:static",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.2",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
